  "queries": [
    {
      "caseId": "synonym-theme",
      "category": "同义改写",
      "query": "界面外观是否应该使用夜间主题？",
      "expectedLabels": ["theme-dark"]
    },
    {
      "caseId": "cross-language-drink",
      "category": "跨语言",
      "query": "What drink does the user like best?",
      "expectedLabels": ["drink-yuzu"]
    },
    {
      "caseId": "negative-notification",
      "category": "否定",
      "query": "晚上十点后还应该给用户发提醒吗？",
      "expectedLabels": ["notification-negative"],
      "forbiddenLabels": ["company-notice"]
    },
    {
      "caseId": "temporal-current-city",
      "category": "时间变化",
      "query": "用户现在在哪个城市办公？",
