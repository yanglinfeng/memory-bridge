{
  "datasetId": "consolidation-quality-v1",
  "schemaVersion": 1,
  "groups": [
    {
      "id": "project-bootstrap",
      "scopeType": "project",
      "scopeKey": "忆桥",
      "sources": [
        {
          "id": "bootstrap-empty-01",
          "text": "用户要求新软件第一次打开时必须保持空数据，不能预置演示记录。"
        },
        {
          "id": "bootstrap-empty-02",
          "text": "所有新应用的首次启动都不应自动塞入样例或演示数据。"
        },
        {
          "id": "bootstrap-empty-03",
          "text": "用户一贯坚持初次打开软件时数据区为空，由自己开始录入。"
        },
        {
          "id": "bootstrap-export-01",
          "text": "忆桥的错误日志必须支持一键导出，并在导出前自动脱敏。"
        },
        {
          "id": "bootstrap-export-02",
          "text": "项目规定诊断日志可以一次点击导出，导出文件不能含明文敏感信息。"
        },
        {
          "id": "bootstrap-export-03",
          "text": "用户要求故障日志导出操作简单，同时对令牌和隐私字段做遮盖。"
        },
        {
          "id": "bootstrap-confirm-01",
          "text": "忆桥内任何会删除数据的操作都必须先向用户二次确认。"
        },
        {
          "id": "bootstrap-confirm-02",
          "text": "项目原则是破坏性动作执行前必须得到明确确认。"
        },
        {
          "id": "bootstrap-confirm-03",
          "text": "用户不允许系统在未确认的情况下清除或覆盖现有数据。"
        }
      ],
      "queries": [
        {
          "id": "query-bootstrap-empty",
          "text": "新软件第一次打开时数据应该是什么状态？",
          "goldSourceIds": [
            "bootstrap-empty-01",
            "bootstrap-empty-02",
            "bootstrap-empty-03"
          ]
        },
        {
          "id": "query-bootstrap-export",
          "text": "忆桥的错误日志应该怎样提供给排障人员？",
          "goldSourceIds": [
            "bootstrap-export-01",
            "bootstrap-export-02",
            "bootstrap-export-03"
          ]
        },
        {
          "id": "query-bootstrap-confirm",
          "text": "系统执行删除数据的操作前有什么要求？",
          "goldSourceIds": [
            "bootstrap-confirm-01",
            "bootstrap-confirm-02",
            "bootstrap-confirm-03"
          ]
        }
      ]
    },
    {
      "id": "work-style",
      "scopeType": "topic",
      "scopeKey": "kind:preference",
      "sources": [
        {
          "id": "style-concise-01",
          "text": "用户偏好回答先给结论，再补充必要细节，并保持简洁。"
        },
        {
          "id": "style-concise-02",
          "text": "回复用户时应结论优先，不要写冗长铺垫。"
        },
        {
          "id": "style-concise-03",
          "text": "用户喜欢短而直接的回答，重要结论应放在最前面。"
        },
        {
          "id": "style-language-01",
          "text": "与用户交流时默认使用简体中文。"
        },
        {
          "id": "style-language-02",
          "text": "用户的首选沟通语言是中文。"
        },
        {
          "id": "style-language-03",
          "text": "除非用户另有要求，回答应使用中文而不是英文。"
        },
        {
          "id": "style-test-01",
          "text": "用户要求项目交付前必须运行真实测试，不能只凭代码审阅判断完成。"
        },
        {
          "id": "style-test-02",
          "text": "完成开发后要先实际验证关键流程，再向用户宣布交付。"
        },
        {
          "id": "style-test-03",
          "text": "用户不接受未经运行测试就声称功能已经通过。"
        }
      ],
      "queries": [
        {
          "id": "query-style-concise",
          "text": "回答用户时应该先说什么，详细程度如何？",
          "goldSourceIds": [
            "style-concise-01",
            "style-concise-02",
            "style-concise-03"
          ]
        },
        {
          "id": "query-style-language",
          "text": "默认应该用哪种语言和用户交流？",
          "goldSourceIds": [
            "style-language-01",
            "style-language-02",
            "style-language-03"
          ]
        },
        {
          "id": "query-style-test",
          "text": "项目交付前是否可以只审代码而不实际测试？",
          "goldSourceIds": [
            "style-test-01",
            "style-test-02",
            "style-test-03"
          ]
        }
      ]
    },
    {
      "id": "travel-health",
      "scopeType": "topic",
      "scopeKey": "kind:profile",
      "sources": [
        {
          "id": "health-peanut-01",
          "text": "用户对花生严重过敏，饮食中必须避开花生及其制品。"
        },
        {
          "id": "health-peanut-02",
          "text": "为用户安排餐食时不能包含花生，因为会引发严重过敏。"
        },
        {
          "id": "health-peanut-03",
          "text": "用户有严重的花生过敏史，点餐时需要明确排除花生。"
        },
        {
          "id": "travel-rail-01",
          "text": "在国内出差时，用户优先选择高铁而不是飞机。"
        },
        {
          "id": "travel-rail-02",
          "text": "用户的国内商务出行交通偏好是高铁优先。"
        },
        {
          "id": "travel-rail-03",
          "text": "安排国内差旅时应先查看高铁方案，用户通常不首选航班。"
        },
        {
          "id": "travel-hotel-01",
          "text": "用户住宿时需要安静的无烟房。"
        },
        {
          "id": "travel-hotel-02",
          "text": "预订酒店要选择无烟且远离电梯的安静房间。"
        },
        {
          "id": "travel-hotel-03",
          "text": "用户的酒店偏好是安静和禁烟，避免嘈杂位置。"
        }
      ],
      "queries": [
        {
          "id": "query-health-peanut",
          "text": "给用户点餐时必须避开什么食物？",
          "goldSourceIds": [
            "health-peanut-01",
            "health-peanut-02",
            "health-peanut-03"
          ]
        },
        {
          "id": "query-travel-rail",
          "text": "安排国内出差时优先选择哪种交通方式？",
          "goldSourceIds": [
            "travel-rail-01",
            "travel-rail-02",
            "travel-rail-03"
          ]
        },
        {
          "id": "query-travel-hotel",
          "text": "给用户预订酒店房间时有哪些偏好？",
          "goldSourceIds": [
            "travel-hotel-01",
            "travel-hotel-02",
            "travel-hotel-03"
          ]
        }
      ]
    },
    {
      "id": "schedule",
      "scopeType": "topic",
      "scopeKey": "kind:event",
      "sources": [
        {
          "id": "schedule-timezone-01",
          "text": "用户的常用时区是 Asia/Shanghai。"
        },
        {
          "id": "schedule-timezone-02",
          "text": "安排用户日程时默认采用上海时区。"
        },
        {
          "id": "schedule-timezone-03",
          "text": "用户所有未注明时区的时间都按 Asia/Shanghai 解释。"
        },
        {
          "id": "schedule-work-01",
          "text": "用户工作日通常在上午九点开始办公。"
        },
        {
          "id": "schedule-work-02",
          "text": "周一到周五，用户的日常开工时间是早上九点。"
        },
        {
          "id": "schedule-work-03",
          "text": "用户平日一般九点进入工作状态。"
        },
        {
          "id": "schedule-meeting-01",
          "text": "项目固定例会在每周一下午三点举行。"
        },
        {
          "id": "schedule-meeting-02",
          "text": "每个星期一 15:00 是项目组例会时间。"
        },
        {
          "id": "schedule-meeting-03",
          "text": "用户每周一下午三点需要参加固定项目会议。"
        }
      ],
      "queries": [
        {
          "id": "query-schedule-timezone",
          "text": "没有特别说明时，用户的日程按哪个时区处理？",
          "goldSourceIds": [
            "schedule-timezone-01",
            "schedule-timezone-02",
            "schedule-timezone-03"
          ]
        },
        {
          "id": "query-schedule-work",
          "text": "用户工作日通常几点开始办公？",
          "goldSourceIds": [
            "schedule-work-01",
            "schedule-work-02",
            "schedule-work-03"
          ]
        },
        {
          "id": "query-schedule-meeting",
          "text": "项目固定例会安排在什么时候？",
          "goldSourceIds": [
            "schedule-meeting-01",
            "schedule-meeting-02",
            "schedule-meeting-03"
          ]
        }
      ]
    }
  ]
}
