      "forbiddenLabels": ["city-old"]
    },
    {
      "caseId": "pronoun-editor",
      "category": "指代",
      "query": "关于林海，他日常主要用什么编辑器？",
      "expectedLabels": ["father-editor"]
    },
    {
      "caseId": "role-scope",
      "category": "跨 scope",
      "query": "在当前角色里应该怎么称呼用户？",
      "scopes": [{"scopeType": "role", "scopeKey": "persona-a"}],
      "expectedLabels": ["role-a-name"],
      "forbiddenLabels": ["role-b-name"]
    },
    {
      "caseId": "project-scope",
      "category": "跨 scope",
      "query": "这个项目发布前必须做什么？",
      "scopes": [{"scopeType": "project", "scopeKey": "project-alpha"}],
      "expectedLabels": ["project-alpha-deploy"],
      "forbiddenLabels": ["project-beta-deploy"]
    },
    {
      "caseId": "distractor-favorite",
      "category": "干扰事实",
      "query": "用户最喜欢的饮品是什么？",
      "expectedLabels": ["drink-yuzu"],
      "forbiddenLabels": ["cafe-menu"]
    },
    {
      "caseId": "post-consolidation",
      "category": "压缩整理后召回",
      "query": "用户希望开发任务怎样汇报？",
      "expectedLabels": [
        "consolidated-work-style",
        "report-source-conclusion",
        "report-source-evidence"
      ],
      "requiredLabels": ["consolidated-work-style"]
    },
    {
      "caseId": "safety-fact",
      "category": "重要事实",
      "query": "给用户推荐餐食时必须避开什么？",
      "expectedLabels": ["peanut-allergy"]
    },
    {
      "caseId": "zero-result",
      "category": "无证据弃答",
      "query": "用户的护照号码是多少？",
