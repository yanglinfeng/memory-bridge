# ============================================================================
# Memory Bridge（忆桥）环境变量样例
# ============================================================================
#
# 这是**参考清单**，不是必需的配置文件。不设任何变量，忆桥也能以出厂默认启动。
#
# 重要：忆桥自身**不读取 .env 文件**（无 dotenv 依赖）。本文件的价值是「可复制的
# 变量清单 + 默认值注释」。要用它，先复制再选一种方式把变量送进进程：
#
#   cp .env.example .env
#
#   # 方式 1（推荐，Node 原生，需 Node ≥ 20.6）
#   node --env-file=.env dist/server/index.js
#
#   # 方式 2（POSIX shell）
#   set -a; . ./.env; set +a; npm start
#
#   # 方式 3（逐条 export，或写进 systemd/launchd 的 Environment）
#   export MEMORY_BRIDGE_DATA_DIR=/absolute/path/to/memory-data
#
# MCP 客户端（Claude Desktop / Cline 等）请在各自的 mcpServers 配置里写 "env" 块，
# 不要依赖当前 shell。
#
# 本文件里所有变量都**默认注释掉**——取消注释即表示「显式设成这个值」，与出厂默认
# 一致，所以复制后不改也能跑。完整清单（95 个）与取值边界见
# docs/configuration-reference.md；默认值的唯一事实源是 src/server/config.ts。
#
# 安全：不要提交 .env（.gitignore 已忽略），不要把它写进截图、日志或 shell 历史。
# 正式环境优先使用账户凭据，而不是下面的 legacy 全局 Token。
# ============================================================================


# ─────────────────────────────────────────────────────────── 网络与存储
# MEMORY_BRIDGE_HOST=127.0.0.1          # 默认 127.0.0.1；只接受 127.0.0.1 / ::1
# MEMORY_BRIDGE_PORT=3789               # 默认 3789；HTTP、管理台与兼容代理共用端口
# MEMORY_BRIDGE_DATA_DIR=/absolute/path/to/memory-data
                                        # 默认 <cwd>/data；SQLite、日志和派生状态都在这里

# ─────────────────────────────────────────────────────── 身份与默认命名空间
# MEMORY_BRIDGE_USER_ID=default         # 默认 default；本机受信任的固定 principal
# MEMORY_BRIDGE_NAMESPACE=personal      # 默认 personal
# MEMORY_BRIDGE_TOKEN=                  # 默认空；legacy 全局 Bearer Token，不推荐长期使用
                                        # 账户凭据模式（manage-identity）优先

# ───────────────────────────────────────────── 多租户隔离（企业内网场景）
# MEMORY_BRIDGE_SESSION_GRANTS_FILE=/absolute/path/to/session-scope-grants.json
                                        # 默认 <dataDir>/session-scope-grants.json
                                        # 主体 → 可签发 scope + clearance 的授权矩阵。
                                        # 文件不存在 = 功能关闭（签发 403，零回归）。
                                        # 按 mtime 热加载，改完即生效。
# MEMORY_BRIDGE_ANONYMOUS_MODE=off      # 默认 off；设 public-readonly 开启匿名公开读：
                                        # loopback 上无令牌请求映射为虚拟主体 @anonymous，
                                        # 仅允许召回，且只可见 public scope + public 密级。

# ───────────────────────────────────────────────────────────────── Ollama
# MEMORY_BRIDGE_OLLAMA_URL=http://127.0.0.1:11434    # 默认同值
# MEMORY_BRIDGE_SEMANTIC_MODE=required  # 默认 required；生产不要设 off
# MEMORY_BRIDGE_MODEL_KEEP_ALIVE=15m    # 默认 15m；-1 表示常驻

# ───────────────────────────────────────────────────────── 模型角色（可分别替换）
# MEMORY_BRIDGE_COMPAT_CHAT_MODEL=qwen2.5:14b        # 兼容代理聊天模型
# MEMORY_BRIDGE_EMBED_MODEL=bge-m3:latest            # embedding 与 Dense generation
# MEMORY_BRIDGE_RERANK_MODEL=qwen2.5:14b             # 批量严格重排
# MEMORY_BRIDGE_EXTRACTION_MODEL=qwen2.5:14b         # 对话原子事实提取
# MEMORY_BRIDGE_RELATION_MODEL=qwen2.5:14b           # 候选五路关系判断
# MEMORY_BRIDGE_EXPLICIT_INTENT_MODEL=qwen2.5:14b    # 自然记住/纠正/遗忘意图
# MEMORY_BRIDGE_CONSOLIDATION_MODEL=qwen2.5:14b      # 非破坏式巩固与来源验证
# MEMORY_BRIDGE_QUERY_MODEL=qwen2.5:14b              # 回答前上下文查询理解
# MEMORY_BRIDGE_REFLECTION_MODEL=qwen2.5:14b         # 跨多轮历史反思

# ───────────────────────────────────────────────────────── 检索与弃答策略
# MEMORY_BRIDGE_ABSTENTION_PROFILE=strict
                                        # 默认 strict；一次切换一组召回闸门。
                                        # strict(门0.35/兜底3/filler0) · balanced(0.30/4/2)
                                        # · eager(0.25/6/4)。知识库建议 balanced。
                                        # 确定性弃答（墓碑、规范值不匹配）永不放宽。
# MEMORY_BRIDGE_MAX_RECALL_CANDIDATES=120       # 默认 120（10–500）
# MEMORY_BRIDGE_MAX_RERANK_CANDIDATES=64        # 默认 64（1–64）
# MEMORY_BRIDGE_CONTEXT_TOKEN_BUDGET=1600       # 默认 1600（256–8192）
# MEMORY_BRIDGE_MIN_RERANK_CONFIDENCE=0.7       # 默认 0.7；未标语料域时的全局门槛

# 语料域门槛：逐候选按 memories.corpus_domain 分档
# MEMORY_BRIDGE_RERANK_GATE_POLICY=0.9          # 制度/合同，从严
# MEMORY_BRIDGE_RERANK_GATE_OPEN=0.65           # 开放语料，从宽
# MEMORY_BRIDGE_RERANK_GATE_CHAT=0.7            # 对话记忆

# 重排提供方
# MEMORY_BRIDGE_RERANK_PROVIDER=llm             # 默认 llm；设 cross_encoder 走本地 sidecar
# MEMORY_BRIDGE_RERANK_CONFIDENCE_WEIGHT=0.45   # relevance = semantic×(1-w) + confidence×w
# MEMORY_BRIDGE_CROSS_ENCODER_URL=http://127.0.0.1:3798
# MEMORY_BRIDGE_CROSS_ENCODER_MODEL=bge-reranker-v2-m3
# 启用 cross_encoder 需先启动 sidecar/ce-rerank（见 sidecar/ce-rerank/README.md）。
# sidecar 不可用时召回走降级路径（qualityState=degraded），**不会**自动回落 LLM 重排。

# ───────────────────────────────────────────────────────── 自动提取（写入门禁）
# MEMORY_BRIDGE_AUTOMATION_MODE=shadow  # 默认 shadow（只进候选）；off / shadow / auto
# MEMORY_BRIDGE_AUTO_COMMIT_MIN_CONFIDENCE=0.95
# MEMORY_BRIDGE_AUTO_COMMIT_MIN_IMPORTANCE=0.5

# ─────────────────────────────────────────── 回答前上下文理解（代词/省略消歧）
# MEMORY_BRIDGE_QUERY_UNDERSTANDING_MODE=auto   # 默认 auto；off / auto / always
# MEMORY_BRIDGE_QUERY_CONTEXT_MESSAGES=6
# MEMORY_BRIDGE_QUERY_CONTEXT_TOKEN_BUDGET=1600
# MEMORY_BRIDGE_QUERY_UNDERSTANDING_MIN_CONFIDENCE=0.78

# ───────────────────────────────────────────────── 后台历史重提炼（反思）
# MEMORY_BRIDGE_REFLECTION_MODE=shadow  # 默认 shadow（产出受审核候选）；off / shadow
# MEMORY_BRIDGE_REFLECTION_LOOKBACK_DAYS=180
# MEMORY_BRIDGE_REFLECTION_MAX_DAILY_CALLS=1000
# MEMORY_BRIDGE_REFLECTION_MIN_PATTERN_EVIDENCE=3   # 范围 3–5
# MEMORY_BRIDGE_REFLECTION_CONCURRENCY=1            # 本机 14B 建议保持 1
# MEMORY_BRIDGE_REFLECTION_IDLE_MINUTES=30
# MEMORY_BRIDGE_REFLECTION_MIN_NEW_TURNS=12
# MEMORY_BRIDGE_REFLECTION_REQUIRE_CROSS_SESSION_EVIDENCE=false
# MEMORY_BRIDGE_REFLECTION_REQUIRE_CROSS_DAY_EVIDENCE=false

# ───────────────────────────────────────────── 巩固 / 保留 / L4 摘要时区
# MEMORY_BRIDGE_CONSOLIDATION_MIN_SOURCES=2
# MEMORY_BRIDGE_CONSOLIDATION_IDLE_MINUTES=15
# MEMORY_BRIDGE_EPISODE_HOT_DAYS=30
# MEMORY_BRIDGE_SUMMARY_TIMEZONE_OFFSET_MINUTES=480
                                        # 默认取本机偏移；**参与摘要 generation key**，
                                        # 改动会使既有 day/week 摘要重算。跨时区部署应
                                        # 在首次导入前定好，生产环境不要随手改。

# ───────────────────────────────────────────────────────── 后台 Worker
# MEMORY_BRIDGE_WORKER_POLL_MS=500
# MEMORY_BRIDGE_EMBED_BATCH_SIZE=64
# MEMORY_BRIDGE_FOREGROUND_QUIET_MS=2000

# ───────────────────────────────────────────────────────── 检索日志与隐私
# MEMORY_BRIDGE_RETRIEVAL_LOG_MODE=metadata     # 默认 metadata；diagnostic 含个人信息，
                                        # 只在限时排障窗口使用
# MEMORY_BRIDGE_RETRIEVAL_JSONL=on      # 默认开启；设为 off 关闭 JSONL 旁路日志
# MEMORY_BRIDGE_RETRIEVAL_JSONL_PATH=/absolute/path/to/logs/retrieval
# MEMORY_BRIDGE_RETRIEVAL_LOG_MAX_BYTES=26214400   # 25 MiB
# MEMORY_BRIDGE_RETRIEVAL_LOG_RETENTION_DAYS=14

# ───────────────────────────────────────────────────── MCP stdio（另起进程时用）
# MEMORY_BRIDGE_MCP_TOKEN=mb1.…         # 仅 MCP stdio 启动时认证，读取后从环境删除
# MEMORY_BRIDGE_MCP_PERSONA_ID=airi-assistant
# MEMORY_BRIDGE_MCP_PROJECT_ID=memory-bridge
# MEMORY_BRIDGE_MCP_SESSION_ID=chat-20260924-001
                                        # persona 与 session 必须成对设置才会启用非个人
                                        # scope；缺项时安全降级为仅 personal/self。
